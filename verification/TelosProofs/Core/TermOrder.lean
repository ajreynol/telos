theorem termCmp_lawful : LawfulCmp termCmp := ⟨termCmp_eq_iff, termCmp_swap, termCmp_trans⟩

/-! ## `native_tcmp` is a strict total order -/

theorem native_tcmp_iff (a b : Term) : native_tcmp a b = true ↔ termCmp a b = .lt := by
  unfold native_tcmp; split <;> simp_all

theorem native_tcmp_irrefl (a : Term) : native_tcmp a a = false := by
  have := (termCmp_eq_iff a a).2 rfl
  unfold native_tcmp; rw [this]

theorem native_tcmp_asymm {a b : Term} (h : native_tcmp a b = true) : native_tcmp b a = false := by
  rw [native_tcmp_iff] at h
  have := termCmp_swap a b
  rw [h] at this
  unfold native_tcmp; rw [this]; rfl

theorem native_tcmp_trans {a b c : Term} (h₁ : native_tcmp a b = true) (h₂ : native_tcmp b c = true) :
    native_tcmp a c = true := by
  rw [native_tcmp_iff] at *; exact termCmp_trans a b c h₁ h₂

theorem native_tcmp_total {a b : Term} (h : a ≠ b) : native_tcmp a b = true ∨ native_tcmp b a = true := by
  rw [native_tcmp_iff, native_tcmp_iff, termCmp_swap a b]
  cases e : termCmp a b
  · simp
  · exact absurd ((termCmp_eq_iff a b).1 e) h
  · simp [Ordering.swap]

end Telos.TermOrder
