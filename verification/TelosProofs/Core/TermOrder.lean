import Cpc.LogosTermOrder

/-!
# Logos's term order is a strict total order

`native_tcmp` (Logos's `Cpc/LogosTermOrder.lean`) orders the monomials of the
polynomial normal forms behind `arith_poly_norm` and `bv_poly_norm`
(`__poly_add`, `__mvar_mul_mvar`). It is `termCmp a b = .lt`, where `termCmp`
compares constructor indices first, then arguments left to right.

Here `termCmp` is proved lawful (`termCmp_lawful`): `eq` exactly on equal terms,
antisymmetric and transitive. Hence `native_tcmp` is a strict total order
(`native_tcmp_irrefl`, `native_tcmp_asymm`, `native_tcmp_trans`,
`native_tcmp_total`), which is what makes Logos's normal forms canonical.

The per-constructor part (from `theorem termCmp_UOp` on) is generated by
`scripts/gen-term-order.py` from the constructors of the mutual block `Term`,
`DatatypeDecl`, `Datatype`, `DatatypeCons`. Regenerate it when Logos changes
that block.
-/

set_option linter.unusedSimpArgs false

open Eo SmtEval

namespace Telos.TermOrder

/-- `f` is a strict total order: `eq` exactly on equal arguments, antisymmetric
(`swap`) and transitive. -/
structure LawfulCmp {α : Type} (f : α → α → Ordering) : Prop where
  eq_iff : ∀ a b, f a b = .eq ↔ a = b
  swap : ∀ a b, f b a = (f a b).swap
  trans : ∀ a b c, f a b = .lt → f b c = .lt → f a c = .lt

theorem natCmp_cases (a b : Nat) :
    (natCmp a b = .lt ∧ a < b) ∨ (natCmp a b = .eq ∧ a = b) ∨ (natCmp a b = .gt ∧ b < a) := by
  unfold natCmp
  by_cases h1 : a < b
  · simp [h1]
  · by_cases h2 : a = b
    · simp [h2]
    · simp [h1, h2]; omega

theorem natCmp_eq_iff (a b : Nat) : natCmp a b = .eq ↔ a = b := by
  rcases natCmp_cases a b with ⟨h, h'⟩ | ⟨h, h'⟩ | ⟨h, h'⟩ <;> rw [h] <;> simp <;> omega

theorem natCmp_swap (a b : Nat) : natCmp b a = (natCmp a b).swap := by
  rcases natCmp_cases a b with ⟨h, h'⟩ | ⟨h, h'⟩ | ⟨h, h'⟩ <;>
  rcases natCmp_cases b a with ⟨g, g'⟩ | ⟨g, g'⟩ | ⟨g, g'⟩ <;> simp [h, g, Ordering.swap] <;> omega

theorem natCmp_trans (a b c : Nat) : natCmp a b = .lt → natCmp b c = .lt → natCmp a c = .lt := by
  rcases natCmp_cases a b with ⟨h, h'⟩ | ⟨h, h'⟩ | ⟨h, h'⟩ <;>
  rcases natCmp_cases b c with ⟨g, g'⟩ | ⟨g, g'⟩ | ⟨g, g'⟩ <;>
  rcases natCmp_cases a c with ⟨k, k'⟩ | ⟨k, k'⟩ | ⟨k, k'⟩ <;> simp [h, g, k] <;> omega

theorem natCmp_lawful : LawfulCmp natCmp := ⟨natCmp_eq_iff, natCmp_swap, natCmp_trans⟩

theorem intCmp_cases (a b : Int) :
    (intCmp a b = .lt ∧ a < b) ∨ (intCmp a b = .eq ∧ a = b) ∨ (intCmp a b = .gt ∧ b < a) := by
  unfold intCmp
  by_cases h1 : a < b
  · simp [h1]
  · by_cases h2 : a = b
    · simp [h2]
    · simp [h1, h2]; omega

theorem intCmp_eq_iff (a b : Int) : intCmp a b = .eq ↔ a = b := by
  rcases intCmp_cases a b with ⟨h, h'⟩ | ⟨h, h'⟩ | ⟨h, h'⟩ <;> rw [h] <;> simp <;> omega

theorem intCmp_swap (a b : Int) : intCmp b a = (intCmp a b).swap := by
  rcases intCmp_cases a b with ⟨h, h'⟩ | ⟨h, h'⟩ | ⟨h, h'⟩ <;>
  rcases intCmp_cases b a with ⟨g, g'⟩ | ⟨g, g'⟩ | ⟨g, g'⟩ <;> simp [h, g, Ordering.swap] <;> omega

theorem intCmp_trans (a b c : Int) : intCmp a b = .lt → intCmp b c = .lt → intCmp a c = .lt := by
  rcases intCmp_cases a b with ⟨h, h'⟩ | ⟨h, h'⟩ | ⟨h, h'⟩ <;>
  rcases intCmp_cases b c with ⟨g, g'⟩ | ⟨g, g'⟩ | ⟨g, g'⟩ <;>
  rcases intCmp_cases a c with ⟨k, k'⟩ | ⟨k, k'⟩ | ⟨k, k'⟩ <;> simp [h, g, k] <;> omega

theorem intCmp_lawful : LawfulCmp intCmp := ⟨intCmp_eq_iff, intCmp_swap, intCmp_trans⟩

theorem boolCmp_lawful : LawfulCmp boolCmp where
  eq_iff a b := by cases a <;> cases b <;> simp [boolCmp]
  swap a b := by cases a <;> cases b <;> simp [boolCmp, Ordering.swap]
  trans a b c := by cases a <;> cases b <;> cases c <;> simp [boolCmp]

theorem match_then (o k : Ordering) : (match o with | .eq => k | o => o) = o.then k := by
  cases o <;> rfl

theorem then_eq_iff (o k : Ordering) : o.then k = .eq ↔ o = .eq ∧ k = .eq := by
  cases o <;> simp [Ordering.then]

theorem then_swap (o k : Ordering) : (o.then k).swap = o.swap.then k.swap := by
  cases o <;> cases k <;> rfl

theorem swap_eq_iff (o : Ordering) : o.swap = .eq ↔ o = .eq := by cases o <;> simp [Ordering.swap]

/-- Lexicographic transitivity. -/
theorem then_trans {α : Type} {f : α → α → Ordering} (hf : LawfulCmp f) {a b c : α}
    {k₁ k₂ k₃ : Ordering} (hk : a = b → b = c → k₁ = .lt → k₂ = .lt → k₃ = .lt) :
    (f a b).then k₁ = .lt → (f b c).then k₂ = .lt → (f a c).then k₃ = .lt := by
  intro h1 h2
  cases e1 : f a b <;> cases e2 : f b c <;> simp [e1, e2, Ordering.then] at h1 h2
  case eq.eq =>
    obtain rfl := (hf.eq_iff _ _).1 e1; obtain rfl := (hf.eq_iff _ _).1 e2
    rw [(hf.eq_iff a a).2 rfl]; exact hk rfl rfl h1 h2
  case eq.lt => obtain rfl := (hf.eq_iff _ _).1 e1; rw [e2]; rfl
  case lt.eq => obtain rfl := (hf.eq_iff _ _).1 e2; rw [e1]; rfl
  case lt.lt => rw [hf.trans _ _ _ e1 e2]; rfl

theorem ratCmp_then (a b : Rat) : ratCmp a b = (intCmp a.num b.num).then (natCmp a.den b.den) := by
  unfold ratCmp; split <;> simp_all [Ordering.then]

theorem ratCmp_lawful : LawfulCmp ratCmp where
  eq_iff a b := by
    rw [ratCmp_then, then_eq_iff, intCmp_eq_iff, natCmp_eq_iff]
    constructor
    · rintro ⟨h1, h2⟩; exact Rat.ext h1 h2
    · rintro rfl; simp
  swap a b := by
    rw [ratCmp_then, ratCmp_then, then_swap, ← intCmp_swap, ← natCmp_swap]
  trans a b c := by
    rw [ratCmp_then, ratCmp_then, ratCmp_then]
    apply then_trans intCmp_lawful
    intro _ _ h3 h4; exact natCmp_trans _ _ _ h3 h4

theorem stringCmp_then (c d : Nat) (s t : List Nat) :
    stringCmp (c :: s) (d :: t) = (natCmp c d).then (stringCmp s t) := by
  rw [stringCmp]; split <;> simp_all [Ordering.then]

theorem stringCmp_eq_iff : ∀ a b : List Nat, stringCmp a b = .eq ↔ a = b
  | [], [] => by simp [stringCmp]
  | [], _ :: _ => by simp [stringCmp]
  | _ :: _, [] => by simp [stringCmp]
  | c :: s, d :: t => by
    rw [stringCmp_then, then_eq_iff, natCmp_eq_iff, stringCmp_eq_iff s t, List.cons.injEq]

theorem stringCmp_swap : ∀ a b : List Nat, stringCmp b a = (stringCmp a b).swap
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | c :: s, d :: t => by
    rw [stringCmp_then, stringCmp_then, then_swap, ← natCmp_swap, ← stringCmp_swap s t]

theorem stringCmp_trans : ∀ a b c : List Nat,
    stringCmp a b = .lt → stringCmp b c = .lt → stringCmp a c = .lt
  | [], [], _ => by simp [stringCmp]
  | [], _ :: _, [] => by simp [stringCmp]
  | [], _ :: _, _ :: _ => by simp [stringCmp]
  | _ :: _, [], _ => by simp [stringCmp]
  | _ :: _, _ :: _, [] => by simp [stringCmp]
  | c :: s, d :: t, e :: u => by
    rw [stringCmp_then, stringCmp_then, stringCmp_then]
    apply then_trans natCmp_lawful
    intro _ _ h3 h4; exact stringCmp_trans s t u h3 h4

theorem stringCmp_lawful : LawfulCmp stringCmp := ⟨stringCmp_eq_iff, stringCmp_swap, stringCmp_trans⟩

/-- Comparing by an injective index into `Nat` is lawful. -/
theorem idxCmp_lawful {α : Type} (idx : α → Nat) (inj : ∀ a b, idx a = idx b → a = b) :
    LawfulCmp (fun a b => natCmp (idx a) (idx b)) where
  eq_iff a b := by
    rw [natCmp_eq_iff]; exact ⟨inj a b, fun h => h ▸ rfl⟩
  swap a b := natCmp_swap _ _
  trans a b c := natCmp_trans _ _ _

theorem userOpCmp_lawful : LawfulCmp userOpCmp :=
  idxCmp_lawful UserOp.ctorIdx fun a b h => by
    rw [← UserOp.ofNat_ctorIdx a, ← UserOp.ofNat_ctorIdx b, h]
theorem userOp1Cmp_lawful : LawfulCmp userOp1Cmp :=
  idxCmp_lawful UserOp1.ctorIdx fun a b h => by
    rw [← UserOp1.ofNat_ctorIdx a, ← UserOp1.ofNat_ctorIdx b, h]
theorem userOp2Cmp_lawful : LawfulCmp userOp2Cmp :=
  idxCmp_lawful UserOp2.ctorIdx fun a b h => by
    rw [← UserOp2.ofNat_ctorIdx a, ← UserOp2.ofNat_ctorIdx b, h]
theorem userOp3Cmp_lawful : LawfulCmp userOp3Cmp :=
  idxCmp_lawful UserOp3.ctorIdx fun a b h => by
    rw [← UserOp3.ofNat_ctorIdx a, ← UserOp3.ofNat_ctorIdx b, h]

/-- Lexicographic transitivity, given equality and transitivity of the first
component. -/
theorem then_trans_g {α : Type} {f : α → α → Ordering} (heq : ∀ a b, f a b = .eq ↔ a = b)
    {x y z : α} {k₁ k₂ k₃ : Ordering} (htr : f x y = .lt → f y z = .lt → f x z = .lt)
    (hk : x = y → y = z → k₁ = .lt → k₂ = .lt → k₃ = .lt) :
    (f x y).then k₁ = .lt → (f y z).then k₂ = .lt → (f x z).then k₃ = .lt := by
  intro h1 h2
  cases e1 : f x y <;> cases e2 : f y z <;> simp [e1, e2, Ordering.then] at h1 h2
  case eq.eq =>
    obtain rfl := (heq _ _).1 e1; obtain rfl := (heq _ _).1 e2
    rw [(heq x x).2 rfl]; exact hk rfl rfl h1 h2
  case eq.lt => obtain rfl := (heq _ _).1 e1; rw [e2]; rfl
  case lt.eq => obtain rfl := (heq _ _).1 e2; rw [e1]; rfl
  case lt.lt => rw [htr e1 e2]; rfl

