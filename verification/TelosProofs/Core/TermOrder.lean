theorem termCmp_ne (a b : Term) (h : a.ctorIdx ≠ b.ctorIdx) :
    termCmp a b = natCmp a.ctorIdx b.ctorIdx := by
  cases a <;> cases b <;> simp_all [termCmp, Term.ctorIdx]
theorem datatypeDeclCmp_ne (a b : DatatypeDecl) (h : a.ctorIdx ≠ b.ctorIdx) :
    datatypeDeclCmp a b = natCmp a.ctorIdx b.ctorIdx := by
  cases a <;> cases b <;> simp_all [datatypeDeclCmp, DatatypeDecl.ctorIdx]
theorem datatypeCmp_ne (a b : Datatype) (h : a.ctorIdx ≠ b.ctorIdx) :
    datatypeCmp a b = natCmp a.ctorIdx b.ctorIdx := by
  cases a <;> cases b <;> simp_all [datatypeCmp, Datatype.ctorIdx]
theorem datatypeConsCmp_ne (a b : DatatypeCons) (h : a.ctorIdx ≠ b.ctorIdx) :
    datatypeConsCmp a b = natCmp a.ctorIdx b.ctorIdx := by
  cases a <;> cases b <;> simp_all [datatypeConsCmp, DatatypeCons.ctorIdx]

/-- Transitivity reduces to the case of three terms with the same constructor. -/
theorem trans_of_ne {α : Type} (f : α → α → Ordering) (idx : α → Nat)
    (hne : ∀ a b, idx a ≠ idx b → f a b = natCmp (idx a) (idx b)) (a b c : α)
    (h : idx a = idx b → idx b = idx c → f a b = .lt → f b c = .lt → f a c = .lt) :
    f a b = .lt → f b c = .lt → f a c = .lt := by
  intro h1 h2
  have le : ∀ x y, f x y = .lt → idx x ≤ idx y := by
    intro x y hxy
    by_cases e : idx x = idx y
    · omega
    · rw [hne _ _ e] at hxy
      rcases natCmp_cases (idx x) (idx y) with ⟨_, k'⟩ | ⟨k, _⟩ | ⟨k, _⟩
      · omega
      · rw [k] at hxy; cases hxy
      · rw [k] at hxy; cases hxy
  have l1 := le _ _ h1; have l2 := le _ _ h2
  by_cases e : idx a = idx c
  · exact h (by omega) (by omega) h1 h2
  · rw [hne _ _ e]
    rcases natCmp_cases (idx a) (idx c) with ⟨k, _⟩ | ⟨_, k'⟩ | ⟨_, k'⟩
    · exact k
    · exact absurd k' e
    · exfalso; omega

theorem termCmp_trans_of {a b c : Term}
    (h : a.ctorIdx = b.ctorIdx → b.ctorIdx = c.ctorIdx → termCmp a b = .lt → termCmp b c = .lt →
      termCmp a c = .lt) : termCmp a b = .lt → termCmp b c = .lt → termCmp a c = .lt :=
  trans_of_ne termCmp Term.ctorIdx termCmp_ne a b c h
theorem datatypeDeclCmp_trans_of {a b c : DatatypeDecl}
    (h : a.ctorIdx = b.ctorIdx → b.ctorIdx = c.ctorIdx → datatypeDeclCmp a b = .lt →
      datatypeDeclCmp b c = .lt → datatypeDeclCmp a c = .lt) :
    datatypeDeclCmp a b = .lt → datatypeDeclCmp b c = .lt → datatypeDeclCmp a c = .lt :=
  trans_of_ne datatypeDeclCmp DatatypeDecl.ctorIdx datatypeDeclCmp_ne a b c h
theorem datatypeCmp_trans_of {a b c : Datatype}
    (h : a.ctorIdx = b.ctorIdx → b.ctorIdx = c.ctorIdx → datatypeCmp a b = .lt →
      datatypeCmp b c = .lt → datatypeCmp a c = .lt) :
    datatypeCmp a b = .lt → datatypeCmp b c = .lt → datatypeCmp a c = .lt :=
  trans_of_ne datatypeCmp Datatype.ctorIdx datatypeCmp_ne a b c h
theorem datatypeConsCmp_trans_of {a b c : DatatypeCons}
    (h : a.ctorIdx = b.ctorIdx → b.ctorIdx = c.ctorIdx → datatypeConsCmp a b = .lt →
      datatypeConsCmp b c = .lt → datatypeConsCmp a c = .lt) :
    datatypeConsCmp a b = .lt → datatypeConsCmp b c = .lt → datatypeConsCmp a c = .lt :=
  trans_of_ne datatypeConsCmp DatatypeCons.ctorIdx datatypeConsCmp_ne a b c h


