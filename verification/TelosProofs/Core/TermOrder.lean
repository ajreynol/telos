  rw [datatypeCmp] <;> (repeat' split) <;> simp_all [Ordering.then, natCmp, Datatype.ctorIdx]

theorem datatypeCmp_sum (x1 y1 : DatatypeCons) (x2 y2 : Datatype) :
    datatypeCmp (.sum x1 x2) (.sum y1 y2) = (datatypeConsCmp x1 y1).then (datatypeCmp x2 y2) := by
  rw [datatypeCmp] <;> (repeat' split) <;> simp_all [Ordering.then, natCmp, Datatype.ctorIdx]

theorem datatypeConsCmp_unit  :
    datatypeConsCmp .unit .unit = .eq := by
  rw [datatypeConsCmp] <;> (repeat' split) <;> simp_all [Ordering.then, natCmp, DatatypeCons.ctorIdx]

theorem datatypeConsCmp_cons (x1 y1 : Term) (x2 y2 : DatatypeCons) :
    datatypeConsCmp (.cons x1 x2) (.cons y1 y2) = (termCmp x1 y1).then (datatypeConsCmp x2 y2) := by
  rw [datatypeConsCmp] <;> (repeat' split) <;> simp_all [Ordering.then, natCmp, DatatypeCons.ctorIdx]

