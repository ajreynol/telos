(set-logic QF_UFFS)
(declare-sort E 0)
(declare-fun A () (Set E))
(declare-fun B () (Set E))
(declare-fun C () (Set E))
(declare-fun D () (Set E))
(declare-fun x () E)
(declare-fun y () E)
(declare-fun z () E)
(declare-fun f (E) E)
(assert (= (as set.empty (Set E)) (set.minus (set.singleton z) (set.inter A C))))
(assert (set.member z B))
(assert (= (f y) (f z)))
(check-sat)
