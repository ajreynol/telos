(set-logic QF_DTLIA)
(declare-datatypes ((P 0)) (((mk (fst Int) (snd Int)))))
(declare-datatypes ((IL 0)) (((inil) (icons (ihd Int) (itl IL)))))
(declare-fun l () IL)
(declare-fun m () IL)
(declare-fun p () P)
(declare-fun q () P)
(declare-fun w () Int)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(assert (or (= m (itl m)) (= (+ (* (- 1) x) z) (- 1)) (= (mk (ihd inil) w) (mk (ihd l) (ihd inil)))))
(assert (or (= (mk (ihd l) (fst p)) q) (= (+ (snd p) (snd (mk z z))) (- 1)) (= (snd (mk w z)) (snd (mk y z)))))
(assert (or (= (ihd inil) (snd (mk w x))) (not (= z x))))
(assert (= (fst q) (fst (mk w w))))
(assert (or ((_ is inil) (icons (ihd m) (icons z m))) ((_ is inil) m)))
(assert (or (= (icons z l) l) (= (+ (* (- 1) y) y) 0) (<= (* 2 (ihd (icons z m))) 3)))
(assert (or (< w (- 2)) (> (* 2 (ihd (icons y m))) 2)))
(assert (or (= (icons (snd q) (itl m)) (itl (icons x l))) (= p p) ((_ is inil) (itl m))))
(check-sat)
