; Nested Boolean connectives (ite, xor, =>, Boolean equality), translated by the CNF stream.
(set-logic QF_UF)
(declare-sort U 0)
(declare-fun u () U)
(declare-fun v () U)
(declare-fun w () U)
(declare-fun f (U) U)
(declare-fun P (U) Bool)
(declare-fun q () Bool)
(assert (ite (P u) (= (f u) v) (xor q (= u w))))
(assert (=> (= (f u) v) (not (P v))))
(assert (= q (P (f w))))
(assert (or (not (= u w)) (P v)))
(assert (not (= (f u) (f v))))
(check-sat)
