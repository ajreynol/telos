(set-logic QF_UFFS)
(declare-sort E 0)
(declare-fun A () (Set E))
(declare-fun B () (Set E))
(declare-fun C () (Set E))
(declare-fun D () (Set E))
(declare-fun x () E)
(declare-fun y () E)
(declare-fun z () E)
(declare-fun f (E) E)
(assert (set.member x (set.minus (set.singleton (f x)) C)))
(assert (= C A))
(assert (= (set.union (set.minus (set.singleton x) (set.singleton y)) (set.singleton x)) (set.inter (set.inter A D) A)))
(check-sat)
