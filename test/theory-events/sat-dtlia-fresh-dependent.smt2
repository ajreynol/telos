(set-logic QF_DTLIA)
(declare-datatypes ((P 0)) (((mk (fst Int) (snd Int)))))
(declare-datatypes ((IL 0)) (((inil) (icons (ihd Int) (itl IL)))))
(declare-fun l () IL)
(declare-fun m () IL)
(declare-fun p () P)
(declare-fun q () P)
(declare-fun w () Int)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(assert (not (= (icons x (itl l)) m)))
(assert (> (+ (ihd l) (snd q)) (- 3)))
(assert (not (= m (icons (snd q) (itl l)))))
(assert (>= (+ (* 2 (snd (mk x w))) (* 2 (fst (mk z y)))) 0))
(assert (= (mk (ihd l) (snd q)) (mk x (fst p))))
(check-sat)
