(set-logic QF_UFFS)
(declare-sort E 0)
(declare-fun A () (Set E))
(declare-fun B () (Set E))
(declare-fun C () (Set E))
(declare-fun D () (Set E))
(declare-fun x () E)
(declare-fun y () E)
(declare-fun z () E)
(declare-fun f (E) E)
(assert (= B D))
(assert (not (= B (set.union D C))))
(assert (not (set.member (f z) (set.singleton x))))
(check-sat)
