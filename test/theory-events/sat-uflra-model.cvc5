(prereg 0 true)
(prereg 0 false)
(prereg 1 (>= (+ (* (- 1) z) (* (- 1) (f x))) (- 2)))
(prereg 1 (= x y))
(prereg 1 (>= (* (- 1) (f y)) (- 1)))
(prereg 1 (>= (+ z (f y)) 1))
(prereg 1 (>= x 0))
(assert 1 THEORY_ARITH (not (>= (+ (* (- 1) z) (* (- 1) (f x))) (- 2))))
(assert 1 THEORY_ARITH (not (>= (+ z (f y)) 1)))
(assert 1 THEORY_ARITH (>= x 0))
(check 1 THEORY_UF EFFORT_STANDARD)
(check 1 THEORY_ARITH EFFORT_STANDARD)
(assert 2 THEORY_UF (not (= x y)))
(assert 2 THEORY_ARITH (not (>= (* (- 1) (f y)) (- 1))))
(check 2 THEORY_UF EFFORT_STANDARD)
(propagate 2 THEORY_BUILTIN (not (= x y)))
(check 2 THEORY_ARITH EFFORT_STANDARD)
(check 2 THEORY_UF EFFORT_FULL)
(check 2 THEORY_ARITH EFFORT_FULL)
sat
