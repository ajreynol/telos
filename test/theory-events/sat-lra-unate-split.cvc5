(prereg 0 true)
(prereg 0 false)
(prereg 1 (>= (+ (* (- 1) x) (* (- 1) y)) (- 2)))
(prereg 1 (>= (+ x y) 2))
(lemma 1 THEORY_ARITH ARITH_UNATE (or (>= (+ (* (- 1) x) (* (- 1) y)) (- 2)) (>= (+ x y) 2)))
(assert 2 THEORY_ARITH (not (>= (+ (* (- 1) x) (* (- 1) y)) (- 2))))
(assert 2 THEORY_ARITH (>= (+ x y) 2))
