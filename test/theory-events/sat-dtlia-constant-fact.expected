(lemma 8 THEORY_DATATYPES DATATYPES_SPLIT (or ((_ is inil) l) ((_ is icons) l)))
(prereg 8 (= inil l))
(prereg 8 ((_ is icons) l))
(assert 9 THEORY_UF (not (= inil l)))
(assert 9 THEORY_DATATYPES ((_ is icons) l))
(check 9 THEORY_UF EFFORT_STANDARD)
(propagate 9 THEORY_BUILTIN (not (= inil l)))
(propagate 9 THEORY_BUILTIN (not (= l inil)))
(propagate 9 THEORY_BUILTIN (not (= l inil)))
