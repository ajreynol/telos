(propagate 9 THEORY_BUILTIN ((_ is icons) l))
(fact 9 THEORY_DATATYPES DATATYPES_INST (= l (icons (ihd l) (itl l))) ((_ is icons) l))
(check 9 THEORY_UF EFFORT_FULL)
(check 9 THEORY_ARITH EFFORT_FULL)
