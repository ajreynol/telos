(set-logic QF_LRA)
(declare-fun w () Real)
(declare-fun x () Real)
(declare-fun y () Real)
(declare-fun z () Real)
(assert (< (+ z x) (- 1)))
(assert (<= (+ x (* 2 y) z) 2))
(assert (< (+ w (* (- 2) z)) 1))
(assert (= (+ w (* (- 2) y)) 0))
(assert (>= (ite (>= (+ (* (- 1) x) (* 2 w) (* 3 y)) 0) (* (- 1) w) (+ (* (- 2) w) x)) (- 1)))
(assert (< (+ (* (- 2) z) (* (- 2) x) (* (- 2) y)) (- 4)))
(check-sat)
