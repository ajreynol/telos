(set-logic QF_LRA)
(declare-fun w () Real)
(declare-fun x () Real)
(declare-fun y () Real)
(declare-fun z () Real)
(assert (or (not (> (+ z x w) 0)) (< (* 2 w) (- 3))))
(assert (>= (+ y (* (- 1) z) (* 2 x)) (- 2)))
(assert (>= (+ w (* (- 2) x)) 1))
(assert (or (< (+ x z w) (- 2)) (>= (+ (* (- 2) w) y) 1) (<= (+ (* (- 1) y) (* 3 w)) (- 2))))
(assert (or (>= (+ (* 3 x) (* 3 w) (* 2 z)) 4) (>= (+ (* 2 z) y (* 3 x)) (- 1))))
(assert (or (>= (+ z (* 2 x) (* 3 y)) 3) (> (+ (* 3 y) (* 2 x) z) (- 1)) (> x 1)))
(check-sat)
