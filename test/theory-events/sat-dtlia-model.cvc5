(prereg 0 true)
(prereg 0 false)
(prereg 1 (= x (+ 2 (snd p))))
(assert 1 THEORY_UF (not (= x (+ 2 (snd p)))))
(check 1 THEORY_UF EFFORT_STANDARD)
(propagate 1 THEORY_BUILTIN (not (= x (+ 2 (snd p)))))
(check 1 THEORY_ARITH EFFORT_STANDARD)
(check 1 THEORY_DATATYPES EFFORT_STANDARD)
(check 1 THEORY_UF EFFORT_FULL)
(check 1 THEORY_ARITH EFFORT_FULL)
(check 1 THEORY_DATATYPES EFFORT_FULL)
(fact 1 THEORY_DATATYPES DATATYPES_SPLIT ((_ is mk) p) true)
(fact 1 THEORY_DATATYPES DATATYPES_INST (= p (mk (fst p) (snd p))) ((_ is mk) p))
sat
