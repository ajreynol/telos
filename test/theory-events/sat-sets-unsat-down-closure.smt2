(set-logic QF_UFFS)
(declare-sort E 0)
(declare-fun A () (Set E))
(declare-fun B () (Set E))
(declare-fun C () (Set E))
(declare-fun D () (Set E))
(declare-fun x () E)
(declare-fun y () E)
(declare-fun z () E)
(declare-fun f (E) E)
(assert (set.member y D))
(assert (= (set.inter C (set.minus B D)) B))
(assert (= D (set.minus B (set.inter D D))))
(assert (not (= C (set.minus (set.minus A C) A))))
(assert (= (set.union (set.inter B (set.singleton y)) (set.minus D (as set.empty (Set E)))) B))
(check-sat)
