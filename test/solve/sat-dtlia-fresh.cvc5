(prereg 0 true)
(prereg 0 false)
(prereg 1 (>= z 3))
(prereg 1 (= p q))
(assert 1 THEORY_ARITH (not (>= z 3)))
(assert 1 THEORY_UF (not (= p q)))
(check 1 THEORY_UF EFFORT_STANDARD)
(propagate 1 THEORY_BUILTIN (not (= p q)))
(check 1 THEORY_ARITH EFFORT_STANDARD)
(check 1 THEORY_DATATYPES EFFORT_STANDARD)
(check 1 THEORY_UF EFFORT_FULL)
(check 1 THEORY_ARITH EFFORT_FULL)
(check 1 THEORY_DATATYPES EFFORT_FULL)
sat
