(prereg 0 true)
(prereg 0 false)
(prereg 1 (P u))
(prereg 1 (= v (f u)))
(prereg 1 (P (f w)))
(prereg 1 (= u w))
(prereg 1 (P v))
(prereg 1 (= (f u) (f v)))
(assert 1 THEORY_UF (not (= (f u) (f v))))
(check 1 THEORY_UF EFFORT_STANDARD)
(propagate 1 THEORY_BUILTIN (not (= (f u) (f v))))
(assert 2 THEORY_UF (not (P u)))
(check 2 THEORY_UF EFFORT_STANDARD)
(propagate 2 THEORY_BUILTIN (not (P u)))
(assert 3 THEORY_UF (not (P v)))
(assert 3 THEORY_UF (not (= u w)))
(assert 3 THEORY_UF (P (f w)))
(check 3 THEORY_UF EFFORT_STANDARD)
(propagate 3 THEORY_BUILTIN (not (P v)))
(propagate 3 THEORY_BUILTIN (not (= u w)))
(propagate 3 THEORY_BUILTIN (P (f w)))
(assert 4 THEORY_UF (not (= v (f u))))
(check 4 THEORY_UF EFFORT_STANDARD)
(propagate 4 THEORY_BUILTIN (not (= v (f u))))
(check 4 THEORY_UF EFFORT_FULL)
sat
