; A disjunction: the SAT solver decides, a theory conflict makes it backtrack; a certified unsat (the SAT solver's refutation, with its certificate).
(set-logic QF_UF)
(declare-sort U 0)
(declare-fun a () U)
(declare-fun b () U)
(declare-fun c () U)
(declare-fun f (U) U)
(assert (or (= a b) (= a c)))
(assert (not (= (f a) (f b))))
(assert (not (= (f a) (f c))))
(check-sat)
