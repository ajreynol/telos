(prereg 0 true)
(prereg 0 false)
(prereg 1 (>= x 3/1))
(prereg 1 (>= y 2/1))
(prereg 1 (>= (+ x y) 1/1))
(prereg 1 (>= (* -1/1 x) 0/1))
(prereg 1 (>= (* -1/1 y) 0/1))
(lemma 1 THEORY_ARITH ARITH_UNATE (or (not (>= (* -1/1 x) 0/1)) (not (>= x 3/1))))
(lemma 1 THEORY_ARITH ARITH_UNATE (or (not (>= (* -1/1 y) 0/1)) (not (>= y 2/1))))
(assert 1 THEORY_ARITH (not (>= (+ x y) 1/1)))
(assert 1 THEORY_ARITH (not (>= (* -1/1 x) 0/1)))
(assert 1 THEORY_ARITH (not (>= (* -1/1 y) 0/1)))
(check 1 THEORY_ARITH EFFORT_STANDARD)
(lemma 1 THEORY_ARITH ARITH_ROW_IMPL (or (>= (+ x y) 1/1) (>= (* -1/1 x) 0/1) (not (>= y 2/1))))
(lemma 1 THEORY_ARITH ARITH_ROW_IMPL (or (>= (+ x y) 1/1) (>= (* -1/1 y) 0/1) (not (>= x 3/1))))
unsat
