(set-logic QF_DTLIA)
(declare-datatypes ((P 0)) (((mk (fst Int) (snd Int)))))
(declare-datatypes ((IL 0)) (((inil) (icons (ihd Int) (itl IL)))))
(declare-fun l () IL)
(declare-fun m () IL)
(declare-fun p () P)
(declare-fun q () P)
(declare-fun w () Int)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(assert (<= (fst (mk z z)) 2))
(assert (not (= q p)))
(assert (or ((_ is inil) (icons (ihd l) (itl inil))) (= y (snd (mk z y)))))
(check-sat)
