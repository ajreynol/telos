(prereg 0 true)
(prereg 0 false)
(prereg 1 (set.member y D))
(prereg 1 (= B (set.inter C (set.minus B D))))
(prereg 1 (= D (set.minus B D)))
(prereg 1 (= C (set.minus (set.minus A C) A)))
(prereg 1 (= B (set.union D (set.inter B (set.singleton y)))))
(assert 1 THEORY_SETS (set.member y D))
(assert 1 THEORY_SETS (= B (set.inter C (set.minus B D))))
(assert 1 THEORY_SETS (= D (set.minus B D)))
(assert 1 THEORY_SETS (not (= C (set.minus (set.minus A C) A))))
