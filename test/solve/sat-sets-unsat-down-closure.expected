(propagate 1 THEORY_BUILTIN (set.member y D))
(propagate 1 THEORY_BUILTIN (= B (set.inter C (set.minus B D))))
(propagate 1 THEORY_BUILTIN (= B (set.inter C (set.minus B D))))
(propagate 1 THEORY_BUILTIN (= D (set.minus B D)))
(propagate 1 THEORY_BUILTIN (= D (set.minus B D)))
(propagate 1 THEORY_BUILTIN (not (= C (set.minus (set.minus A C) A))))
