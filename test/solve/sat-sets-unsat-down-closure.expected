(check 1 THEORY_SETS EFFORT_FULL)
(lemma 1 THEORY_SETS SETS_PROXY (= @purify_1 (set.singleton y)))
(prereg 1 (= (set.singleton y) @purify_1))
(lemma 1 THEORY_SETS SETS_PROXY_SINGLETON (set.member y @purify_1))
(prereg 1 (set.member y @purify_1))
(assert 1 THEORY_SETS (= (set.singleton y) @purify_1))
(assert 1 THEORY_SETS (set.member y @purify_1))
