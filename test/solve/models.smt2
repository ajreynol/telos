; get-model and get-value, as cvc5 prints them, across theories
(set-logic ALL)
(set-option :produce-models true)
(declare-sort U 0)
(declare-const u U)
(declare-const v U)
(declare-const x Int)
(declare-const r Real)
(declare-const s String)
(declare-const b Bool)
(declare-fun f (Int Bool) Int)
(declare-datatypes ((L 0)) (((nil) (cons (hd Int) (tl L)))))
(declare-const l L)
(declare-datatypes ((Lst 1)) ((par (T) ((lnil) (lcons (lhd T) (ltl (Lst T)))))))
(declare-const p (Lst Int))
(declare-const S (Set Int))
(declare-const unused Int)
(assert (not (= u v)))
(assert (= (f x b) 3))
(assert (= (f 2 false) (- 4)))
(assert (< r (- 0.5)))
(assert (= (str.len s) 2))
(assert ((_ is cons) l))
(assert (= p (as lnil (Lst Int))))
(assert (set.member 1 S))
(check-sat)
(get-model)
(get-value (x (f x b) (+ r 1) p))
