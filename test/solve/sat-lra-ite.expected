(prereg 0 true)
(prereg 0 false)
(prereg 1 (>= (+ (* -1/1 w) x) 2/1))
(prereg 1 (>= @purify_1 -3/1))
(prereg 1 (>= (* -1/1 x) 1/1))
(prereg 1 (= (* 3/1 x) @purify_1))
(prereg 1 (= x @purify_1))
(assert 1 THEORY_ARITH (>= (+ (* -1/1 w) x) 2/1))
(assert 1 THEORY_ARITH (>= @purify_1 -3/1))
(check 1 THEORY_ARITH EFFORT_STANDARD)
(assert 2 THEORY_ARITH (not (>= (* -1/1 x) 1/1)))
(assert 2 THEORY_ARITH (= x @purify_1))
(check 2 THEORY_ARITH EFFORT_STANDARD)
(check 2 THEORY_ARITH EFFORT_FULL)
sat
