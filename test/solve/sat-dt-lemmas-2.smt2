(set-logic QF_UFDT)
(declare-sort U 0)
(declare-datatypes ((Lst 0)) (((nil) (cons (head U) (tail Lst)))))
(declare-datatypes ((Tree 0)) (((leaf (val U)) (node (left Tree) (right Tree)))))
(declare-datatypes ((Col 0)) (((red) (green) (blue))))
(declare-datatypes ((Pr 0)) (((pr (fst Col) (snd Lst)))))
(declare-fun a () U)
(declare-fun b () U)
(declare-fun x () Lst)
(declare-fun y () Lst)
(declare-fun z () Lst)
(declare-fun s () Tree)
(declare-fun t () Tree)
(declare-fun c () Col)
(declare-fun d () Col)
(declare-fun p () Pr)
(declare-fun f (Lst) Lst)
(assert (= (pr red (tail nil)) (pr (fst p) (cons b y))))
(assert (or ((_ is cons) z) (= (head y) (val t)) (not (= (snd p) y))))
(assert (or (= b a) ((_ is green) c)))
(assert (= (cons (val s) (tail y)) (cons a y)))
(check-sat)
