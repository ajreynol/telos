; A clash of constructors (DATATYPES_CLASH_CONFLICT), certified by dt-cons-eq-clash.
(set-logic QF_UFDT)
(declare-sort U 0)
(declare-datatypes ((Lst 0)) (((nil) (cons (head U) (tail Lst)))))
(declare-datatypes ((Tree 0)) (((leaf (val U)) (node (left Tree) (right Tree)))))
(declare-datatypes ((Col 0)) (((red) (green) (blue))))
(declare-datatypes ((Pr 0)) (((pr (fst Col) (snd Lst)))))
(declare-fun a () U)
(declare-fun b () U)
(declare-fun x () Lst)
(declare-fun y () Lst)
(declare-fun z () Lst)
(declare-fun s () Tree)
(declare-fun t () Tree)
(declare-fun c () Col)
(declare-fun d () Col)
(declare-fun p () Pr)
(declare-fun f (Lst) Lst)
(assert ((_ is blue) (fst p)))
(assert ((_ is nil) (f nil)))
(assert (= p (pr (fst p) (cons a z))))
(assert (= p (pr blue (cons a nil))))
(assert (not ((_ is nil) y)))
(assert (= (tail (cons b y)) (cons b y)))
(assert (= y (cons b (cons a z))))
(check-sat)
