(prereg 0 true)
(prereg 0 false)
(prereg 1 (let ((_let_1 (leaf b))) (= (node s _let_1) (right _let_1))))
(prereg 1 (= a (head nil)))
(prereg 1 (= a b))
(prereg 1 (= a (val s)))
(assert 1 THEORY_DATATYPES (let ((_let_1 (leaf b))) (= (node s _let_1) (right _let_1))))
(assert 1 THEORY_DATATYPES (not (= a (head nil))))
(check 1 THEORY_UF EFFORT_STANDARD)
(check 1 THEORY_DATATYPES EFFORT_STANDARD)
(propagate 1 THEORY_BUILTIN (let ((_let_1 (leaf b))) (= (node s _let_1) (right _let_1))))
(propagate 1 THEORY_BUILTIN (let ((_let_1 (leaf b))) (= (node s _let_1) (right _let_1))))
(propagate 1 THEORY_BUILTIN (not (= a (head nil))))
(assert 2 THEORY_UF (not (= a b)))
(assert 2 THEORY_DATATYPES (= a (val s)))
(check 2 THEORY_UF EFFORT_STANDARD)
(propagate 2 THEORY_BUILTIN (not (= a b)))
(propagate 2 THEORY_BUILTIN (not (= b a)))
(propagate 2 THEORY_BUILTIN (not (= b a)))
(check 2 THEORY_DATATYPES EFFORT_STANDARD)
(propagate 2 THEORY_BUILTIN (= a (val s)))
(propagate 2 THEORY_BUILTIN (= a (val s)))
(check 2 THEORY_UF EFFORT_FULL)
(check 2 THEORY_DATATYPES EFFORT_FULL)
(lemma 2 THEORY_DATATYPES DATATYPES_SPLIT (or ((_ is leaf) s) ((_ is node) s)))
(prereg 2 ((_ is leaf) s))
(prereg 2 ((_ is node) s))
(assert 3 THEORY_DATATYPES (not ((_ is leaf) s)))
(assert 3 THEORY_DATATYPES ((_ is node) s))
(check 3 THEORY_UF EFFORT_STANDARD)
(check 3 THEORY_DATATYPES EFFORT_STANDARD)
(propagate 3 THEORY_BUILTIN (not ((_ is leaf) s)))
(fact 3 THEORY_DATATYPES DATATYPES_LABEL_EXH ((_ is node) s) (not ((_ is leaf) s)))
(propagate 3 THEORY_BUILTIN ((_ is node) s))
(fact 3 THEORY_DATATYPES DATATYPES_INST (= s (node (left s) (right s))) ((_ is node) s))
(check 3 THEORY_UF EFFORT_FULL)
(check 3 THEORY_DATATYPES EFFORT_FULL)
sat
