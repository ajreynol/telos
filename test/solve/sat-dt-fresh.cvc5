(prereg 0 true)
(prereg 0 false)
(prereg 1 (= x y))
(prereg 1 (= nil x))
(prereg 1 (= y z))
(prereg 1 (= x z))
(assert 1 THEORY_UF (not (= x y)))
(assert 1 THEORY_UF (not (= nil x)))
(assert 1 THEORY_UF (not (= y z)))
(assert 1 THEORY_UF (not (= x z)))
(check 1 THEORY_UF EFFORT_STANDARD)
(propagate 1 THEORY_BUILTIN (not (= x y)))
(propagate 1 THEORY_BUILTIN (not (= nil x)))
(propagate 1 THEORY_BUILTIN (not (= y z)))
(propagate 1 THEORY_BUILTIN (not (= x z)))
(check 1 THEORY_DATATYPES EFFORT_STANDARD)
(check 1 THEORY_UF EFFORT_FULL)
(check 1 THEORY_DATATYPES EFFORT_FULL)
sat
