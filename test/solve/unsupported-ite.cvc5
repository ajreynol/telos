(prereg 0 true)
(prereg 0 false)
(prereg 1 (p @purify_1))
(prereg 1 (p c))
(prereg 1 (= (f a) (f c)))
(prereg 1 (= a @purify_1))
(prereg 1 (= b @purify_1))
(assert 1 THEORY_UF (p @purify_1))
(assert 1 THEORY_UF (not (p c)))
(assert 1 THEORY_UF (not (= (f a) (f c))))
(check 1 THEORY_UF EFFORT_STANDARD)
(propagate 1 THEORY_BUILTIN (p @purify_1))
(propagate 1 THEORY_BUILTIN (not (p c)))
(propagate 1 THEORY_BUILTIN (not (= (f a) (f c))))
(assert 2 THEORY_UF (= b @purify_1))
(check 2 THEORY_UF EFFORT_STANDARD)
(propagate 2 THEORY_BUILTIN (= b @purify_1))
(assert 3 THEORY_UF (= a @purify_1))
(check 3 THEORY_UF EFFORT_STANDARD)
(propagate 3 THEORY_BUILTIN (= a @purify_1))
(check 4 THEORY_UF EFFORT_FULL)
sat
