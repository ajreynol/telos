(set-logic QF_DTLIA)
(declare-datatypes ((P 0)) (((mk (fst Int) (snd Int)))))
(declare-datatypes ((IL 0)) (((inil) (icons (ihd Int) (itl IL)))))
(declare-fun l () IL)
(declare-fun m () IL)
(declare-fun p () P)
(declare-fun q () P)
(declare-fun w () Int)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(assert (= (itl (itl m)) (icons y (itl inil))))
(assert (or (< (+ y (* (- 1) (ihd inil))) 1) ((_ is inil) l)))
(assert (< (+ (* (- 1) x) (* 2 (ihd inil))) (- 2)))
(assert (or (not ((_ is inil) (icons (ihd inil) m))) (not (< y 2)) (not (> (+ (snd (mk z w)) (fst (mk y w))) (- 1)))))
(assert (or ((_ is inil) l) (<= y (- 3)) (= (+ (ihd (icons y inil)) (snd (mk z w))) 0)))
(assert (or (not (>= (+ (ihd (icons y l)) (* 2 (fst (mk z z)))) (- 1))) (>= (+ (fst (mk w z)) (* (- 1) x)) 3) (= (itl l) (icons (ihd inil) inil))))
(check-sat)
