(set-logic QF_LRA)
(declare-fun w () Real)
(declare-fun x () Real)
(declare-fun y () Real)
(declare-fun z () Real)
(assert (or (not (<= (+ w (* (- 2) y)) (- 1))) (> (+ (* 2 x) w) 2)))
(assert (or (>= (* (- 2) x) 1) (< (* (- 2) y) 0) (< (+ (* 2 x) w z) (- 1))))
(assert (<= (+ (* (- 1) x) (* (- 2) y)) 0))
(assert (or (<= z 2) (< (+ x (* 2 w)) (- 1)) (>= (+ (* 2 z) w) 3)))
(assert (<= y (- 2)))
(assert (or (<= (+ (* 3 x) (* (- 2) z)) (- 4)) (> (+ x (* (- 2) y)) 1)))
(check-sat)
