; Arrays (cvc5's TheoryArraysRewriter): select over store, store over store,
; and equalities of arrays.
(set-logic ALL)
(declare-const a (Array Int Int))
(declare-const b (Array Int Int))
(declare-const x Int)
(declare-const y Int)
(simplify (select (store a x 1) x))
(simplify (select (store a 0 1) 2))
(simplify (select (store (store a 0 1) 1 2) 0))
(simplify (select (store a x 1) y))
(simplify (select (store a x 1) (+ x 1)))
(simplify (store (store a x 1) x 2))
(simplify (store a x (select a x)))
(simplify (store (store a 1 5) 1 (select a 1)))
(simplify (store (store a (+ x 1) 5) x 6))
(simplify (= a a))
(simplify (= b a))
(simplify (= (select (store a x 1) x) 1))
