; Bit-vectors (cvc5's TheoryBVRewriter): eliminations, constant evaluation,
; extracts, concatenations and comparisons.
(set-logic ALL)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(declare-const z (_ BitVec 4))
(simplify (bvugt x y))
(simplify (bvsge x y))
(simplify (bvsub x y))
(simplify (bvadd #b0001 #b0010))
(simplify (bvmul #b0011 #b0101))
(simplify (= x x))
(simplify (= #b0001 #b0010))
(simplify (= y x))
(simplify (bvnot (bvnot x)))
(simplify (bvite #b1 x y))
(simplify (bvite #b0 x y))
(simplify ((_ extract 3 0) x))
(simplify ((_ extract 1 0) (bvnot x)))
(simplify ((_ extract 1 0) ((_ extract 2 1) x)))
(simplify ((_ extract 5 2) (concat x y)))
(simplify (concat (concat x y) z))
(simplify ((_ zero_extend 2) x))
(simplify ((_ zero_extend 0) x))
(simplify ((_ rotate_left 1) x))
(simplify ((_ rotate_right 1) x))
(simplify (bvshl x #b0000))
(simplify (bvlshr x #b0001))
(simplify (bvult x #b0000))
(simplify (bvult x #b1111))
(simplify (bvult x x))
(simplify (bvule x #b1111))
(simplify (bvudiv x #b0001))
(simplify (bvurem x #b0001))
(simplify (bvxnor x y))
(simplify (bvnand x y))
(simplify (bvredor x))
(simplify (bvcomp #b0001 #b0001))
(simplify (bvsdiv x y))
; normalizations of whole n-ary terms
(simplify (bvadd x x))
(simplify (bvadd x (bvadd y #b0001) #b0010))
(simplify (bvadd x (bvneg x)))
(simplify (bvneg (bvneg x)))
(simplify (bvneg (bvsub x y)))
(simplify (bvmul #b0001 x))
(simplify (bvmul x #b0000))
(simplify (bvand x #b0000))
(simplify (bvand x #b1111 x))
(simplify (bvand x (bvnot x)))
(simplify (bvor x (bvnot x)))
(simplify (bvor x #b0011 #b0100))
(simplify (bvxor x y x))
(simplify (bvxor x #b0000))
(simplify (bvxor x #b1111))
(simplify (bvult #b1111 x))
(simplify ((_ repeat 2) x))
(simplify (bvand x #b0011))
; constant bvcomp, overflow predicates of constants, comparisons with extends
(simplify (bvcomp #b0101 #b0101))
(simplify (bvredand #b0101))
(simplify (bvumulo #b1111 #b1111))
(simplify (bvsmulo #b0001 #b0001))
(simplify (bvult ((_ sign_extend 2) ((_ extract 3 2) x)) #b0101))
(simplify (bvult #b0001 ((_ sign_extend 2) ((_ extract 3 2) x))))
(simplify (bvult ((_ zero_extend 2) ((_ extract 3 2) x)) #b0010))
(simplify (bvsaddo y (bvudiv x #b0000)))
