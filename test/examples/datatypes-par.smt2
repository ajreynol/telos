; Parametric datatypes (instantiated by Logos's parser) and tuples (cvc5's
; DatatypesRewriter): selectors, testers, updaters, clashes, and printing with
; cvc5's (as C T) for the constructors of parametric datatypes.
(set-logic ALL)
(declare-datatypes ((Lst 1)) ((par (T) ((nl) (cns (hd T) (tl (Lst T)))))))
(declare-datatypes ((Pair 2) (Color 0)) ((par (T S) ((pair (first T) (second S)))) ((red) (blue))))
(declare-datatype Opt (par (X) ((none) (some (val X)))))
(declare-const l (Lst Int))
(declare-const lb (Lst Bool))
(declare-const p (Pair Int Bool))
(declare-const q (Pair Color (Lst Int)))
(declare-const o (Opt (Pair Int Bool)))
(declare-datatypes ((PL 1)) ((par (T) ((pnil) (pcons (phd T) (ptl (PL T)))))))
(declare-const pl (PL Int))
(declare-const x Int)
(declare-const y Int)
(declare-const t (Tuple Int Bool))
(declare-const u (Tuple Int Int))
(simplify (hd (cns x l)))
(simplify (tl (as nl (Lst Int))))
(simplify ((_ is nl) l))
(simplify ((_ is cns) (cns x l)))
(simplify (= (cns 1 l) (as nl (Lst Int))))
(simplify (= l (cns x (as nl (Lst Int)))))
(simplify (first (pair x true)))
(simplify (= p (pair 1 false)))
(simplify ((_ update first) (pair x true) 3))
(simplify (= (pair x true) (pair 1 false)))
(simplify (second q))
(simplify (= (first q) red))
(simplify (= q (pair blue (as nl (Lst Int)))))
(simplify (val (some p)))
(simplify (= o (as none (Opt (Pair Int Bool)))))
(simplify ((_ is some) o))
(simplify (= lb (cns true lb)))
(simplify (cns (hd (cns x l)) l))
(simplify ((_ is pnil) (as pnil (PL Int))))
(simplify ((_ is pcons) ((as pcons (PL Int)) x pl)))
(simplify ((_ is pnil) ((as pcons (PL Int)) x pl)))
(simplify ((_ is pcons) (as pnil (PL Int))))
(simplify ((_ tuple.select 0) (tuple x true)))
(simplify ((_ tuple.select 1) t))
(simplify (= t (tuple 1 false)))
(simplify (= (tuple x true) (tuple 1 false)))
(simplify (= (tuple x true) (tuple 1 true)))
(simplify ((_ tuple.update 0) (tuple x true) 3))
(simplify ((_ tuple.update 0) t 3))
(simplify (= tuple.unit tuple.unit))
(simplify (tuple (+ x 0) (tuple y)))
(simplify (= (tuple 1 2) (tuple 1 2)))
(simplify (= (tuple x 2) (tuple y 3)))
(simplify (= (tuple x y) (tuple y x)))
(simplify ((_ tuple.select 0) ((_ tuple.update 1) u 5)))
(simplify ((_ tuple.select 1) ((_ tuple.update 1) (tuple x y) (+ y 1))))
(simplify (= ((_ tuple.select 0) u) ((_ tuple.select 1) u)))
(simplify (ite (= x 0) (tuple x y) u))
