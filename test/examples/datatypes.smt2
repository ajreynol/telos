; Datatypes (cvc5's DatatypesRewriter): selectors, testers and updaters of
; constructor applications, testers of nullary constructors and of datatypes
; with one constructor, and equalities of datatypes (clashes, orientation).
(set-logic ALL)
(declare-datatypes ((Lst 0)) (((nil) (cons (head Int) (tail Lst)))))
(declare-datatype Color ((red) (green) (blue)))
(declare-datatype Pair ((mkpair (fst Int) (snd Bool))))
(declare-datatypes ((Tree 0) (Forest 0)) (((leaf (val Int)) (node (children Forest))) ((fnil) (fcons (fhead Tree) (ftail Forest)))))
(declare-const x Lst)
(declare-const y Lst)
(declare-const n Int)
(declare-const c Color)
(declare-const p Pair)
(declare-const t Tree)
(simplify (head (cons 1 x)))
(simplify (tail (cons 1 x)))
(simplify (head nil))
(simplify (tail (tail (cons 1 (cons 2 nil)))))
(simplify ((_ is cons) (cons n x)))
(simplify ((_ is nil) (cons n x)))
(simplify ((_ is cons) x))
(simplify ((_ is nil) x))
(simplify ((_ is red) c))
(simplify ((_ is mkpair) p))
(simplify ((_ update head) (cons 1 x) 2))
(simplify ((_ update head) nil 2))
(simplify ((_ update head) x 2))
(simplify (= x x))
(simplify (= nil (cons 1 x)))
(simplify (= (cons 1 x) (cons 2 y)))
(simplify (= (cons n x) (cons n y)))
(simplify (= (cons 1 nil) (cons 1 (cons 2 nil))))
(simplify (= x nil))
(simplify (= y x))
(simplify (= red green))
(simplify (= c blue))
(simplify (= (mkpair 1 true) (mkpair 1 false)))
(simplify (fst (mkpair n true)))
(simplify (val (leaf 3)))
(simplify (fhead (fcons t fnil)))
(simplify ((_ is node) (leaf 3)))
(simplify (= (node fnil) (leaf n)))
(simplify (= x (cons 1 x)))
(simplify (and ((_ is cons) x) (= (head x) 1)))
(simplify ((_ update tail) (cons 1 x) nil))
(simplify (= (= red c) (= blue c)))
(simplify (distinct red green blue))
