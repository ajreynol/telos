(set-logic ALL)
(declare-const a Bool)
(declare-const b Bool)
(declare-const x Int)
(declare-fun f (Int) Bool)
(simplify (not (not a)))
(simplify (and a true b))
(simplify (ite (not a) b false))
(simplify (= (= x 0) true))
(simplify (or (f x) (not (not (f x)))))
(simplify (forall ((y Int)) (and (= y x) true)))
(simplify (xor a a))
