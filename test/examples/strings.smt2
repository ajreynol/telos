; Strings (cvc5's SequencesRewriter, partly ported): concatenation, length,
; prefixes and suffixes, substrings (with arithmetic entailment), eliminations.
(set-logic ALL)
(declare-const s String)
(declare-const t String)
(declare-const x Int)
(declare-const r RegLan)
(simplify (str.++ s "ab" "c"))
(simplify (str.len (str.++ s "abc")))
(simplify (str.substr "abcde" 1 2))
(simplify (str.at s 0))
(simplify (str.to_int "12"))
(simplify (str.from_int 12))
(simplify (str.rev "abc"))
(simplify (= s s))
(simplify (str.prefixof s s))
(simplify (str.prefixof (str.++ s t) s))
(simplify (str.suffixof (str.++ t s "a") s))
(simplify (str.prefixof s t))
(simplify (str.len (str.replace s t t)))
(simplify (str.substr "" x 2))
(simplify (str.substr s (- 1) x))
(simplify (str.substr s x 0))
(simplify (str.substr (str.substr s 0 2) 3 x))
(simplify (str.substr (str.substr s 1 5) 2 3))
(simplify (str.substr (str.replace s "a" "b") 0 x))
(simplify (str.substr "a" x x))
(simplify ((_ re.^ 2) (str.to_re "a")))
(simplify (re.opt (str.to_re "a")))
(simplify (re.range "b" "a"))
(simplify (re.union r re.all))
(simplify (re.inter r re.all))
(simplify (re.union r (re.union r (str.to_re "a"))))
(simplify (re.inter (str.to_re "a") (str.to_re "b")))
(simplify (re.* (re.* r)))
(simplify (re.* (str.to_re "")))
(simplify (re.* re.none))
(simplify (re.* (re.union r re.allchar)))
(simplify (re.* (re.union r (str.to_re ""))))
(simplify re.all)
(simplify (re.inter re.all re.all))
(simplify (str.in_re "ab" (re.* (str.to_re "ab"))))
(simplify (str.in_re "ab" (re.* (str.to_re "a"))))
(simplify (str.in_re s re.allchar))
(simplify (str.in_re s (re.* re.allchar)))
(simplify (str.in_re s (re.++ (re.* re.allchar) (str.to_re "ab") (re.* re.allchar))))
(simplify (str.in_re s (re.union r (str.to_re "a"))))
(simplify (str.in_re s (re.inter r (str.to_re "a") (re.* r))))
(simplify (str.in_re s (str.to_re "a")))
(simplify (str.in_re s (re.range "a" "c")))
(simplify (str.in_re s (re.comp r)))
(simplify (str.substr s 0 (str.len s)))
(simplify (str.substr (str.++ s t) 0 (str.len s)))
(simplify (str.substr (str.++ s t) (str.len s) x))
(simplify (str.substr (str.++ s "ab" t) (+ (str.len s) 2) x))
(simplify (str.substr (str.++ s t) 0 (+ (str.len s) 1)))
(simplify (str.substr (str.++ s t) 0 x))
(simplify (str.substr (str.++ s t) 1 (str.len s)))
; containment (StringsEntail::checkContains uses the full rewriter)
(simplify (str.contains (str.++ s "abc" t) "b"))
(simplify (str.contains (str.++ s "abc" t) (str.++ "bc" t)))
(simplify (str.contains (str.++ s t s) "a"))
(simplify (str.contains (str.++ s "abc" t) "z"))
(simplify (str.contains (str.++ s "b") (str.++ "a" s)))
(simplify (str.contains (str.++ "ab" s) (str.++ "cd" t)))
(simplify (str.contains (str.substr s x (str.len t)) t))
(simplify (str.contains (str.replace s t s) t))
(simplify (str.contains (str.from_int x) "a"))
(simplify (str.contains s (str.++ "a" (str.replace s "b" "c"))))
; replacement
(simplify (str.replace (str.++ "abc" s) "b" t))
(simplify (str.replace (str.++ s "ab") (str.++ s "a") t))
(simplify (str.replace (str.++ s "ab") "a" t))
(simplify (str.replace (str.++ "b" s "b") "a" t))
(simplify (str.replace (str.++ s t s) "a" t))
(simplify (str.replace s (str.replace s t s) s))
(simplify (str.replace_all "abab" "b" s))
(simplify (str.replace_all s t t))
; indexof, reverse, conversions, comparisons
(simplify (str.indexof (str.++ "abc" s) "b" 0))
(simplify (str.indexof s (str.++ s "a") x))
(simplify (str.indexof (str.++ s t s) t 0))
(simplify (str.indexof (str.++ s "a") "b" 0))
(simplify (str.indexof s s 2))
(simplify (str.rev (str.++ s "ab" t)))
(simplify (str.to_lower (str.++ s "AB" t)))
(simplify (str.to_int (str.++ s "a" t)))
(simplify (str.<= (str.++ "ab" s) (str.++ "ac" t)))
(simplify (str.<= (str.++ "b" s) (str.++ "abc" t)))
(simplify (str.< s t))
; regular expression inclusion
(simplify (str.in_re (str.++ "ab" s) (re.++ (str.to_re "a") (re.* re.allchar))))
(simplify (str.in_re (str.++ s "ab" t) (re.++ (re.* re.allchar) (str.to_re "b") (re.* re.allchar))))
(simplify (str.in_re (str.++ "a" (str.from_int (str.len s))) (re.++ (str.to_re "a") (re.+ (re.range "0" "9")))))
(simplify (str.in_re s (re.++ (str.to_re "a") (re.* re.allchar))))
(simplify (re.inter (re.++ (str.to_re "a") (re.* re.allchar)) (re.comp (re.* re.allchar)) (str.to_re t)))
(simplify (re.union (re.comp (str.to_re "a")) (re.++ (str.to_re "a") (re.* re.allchar)) r))
; loops
(simplify ((_ re.loop 3 2) r))
(simplify ((_ re.loop 0 0) r))
(simplify ((_ re.loop 1 3) (re.* r)))
(simplify ((_ re.loop 1 1) r))
(simplify ((_ re.loop 0 2) r))
(simplify ((_ re.loop 2 3) (re.++ r (str.to_re "a"))))
(simplify (str.in_re s ((_ re.loop 2 3) (re.range "a" "c"))))
