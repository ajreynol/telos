; Equalities over uninterpreted sorts and `distinct` (cvc5's TheoryUfRewriter).
(set-logic ALL)
(declare-sort U 0)
(declare-const a Bool)
(declare-const b Bool)
(declare-const x Int)
(declare-const y Int)
(declare-const u U)
(declare-const v U)
(declare-const w U)
(declare-fun f (U) U)
(simplify (= u u))
(simplify (= v u))
(simplify (= (f v) u))
(simplify (not (= (f u) (f u))))
(simplify (distinct u v))
(simplify (distinct u v w))
(simplify (distinct u v u))
(simplify (distinct x 1))
(simplify (distinct 1 2 3))
(simplify (distinct 1 1))
(simplify (distinct a b true))
(simplify (distinct a b))
(simplify (not (distinct u (f u))))
