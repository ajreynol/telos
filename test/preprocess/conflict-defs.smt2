; From fuzzing: a := true is learned, and a later pass finds the conflict; the
; definition is kept, as cvc5 keeps its top-level substitutions.
(set-logic ALL)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const x Int)
(declare-const y Int)
(declare-const r Real)
(declare-const s Real)
(declare-sort U 0)
(declare-const u U)
(declare-const v U)
(declare-const w U)
(declare-fun f (U) U)
(declare-const bx (_ BitVec 4))
(declare-const by (_ BitVec 4))
(declare-const bz (_ BitVec 4))
(declare-const aa (Array Int Int))
(declare-const ab (Array Int Int))
(declare-const am (Array (_ BitVec 4) Int))
(declare-const bm (Array U U))
(declare-const cm (Array U U))
(declare-const su String)
(declare-const sv String)
(declare-const sa (Set Int))
(declare-const sb (Set Int))
(declare-datatypes ((Lst 0)) (((nil) (cons (head Int) (tail Lst)))))
(declare-datatypes ((Color 0)) (((red) (green) (blue))))
(declare-const la Lst)
(declare-const lb Lst)
(declare-const co Color)
(declare-datatypes ((Pair 2)) ((par (T S) ((pair (first T) (second S))))))
(declare-datatypes ((PL 1)) ((par (T) ((pnil) (pcons (phd T) (ptl (PL T)))))))
(declare-const pa (Pair Int Color))
(declare-const pl (PL Int))
(declare-const tp (Tuple Int Color))
(declare-const tq (Tuple Int Int))
(assert (ite a (=> ((_ is cons) (cons (head (cons x nil)) (cons (head nil) lb))) (= ((_ update first) pa 0) ((_ update first) pa ((_ tuple.select 0) tp)))) (and (= (tail (cons 2 lb)) (cons (head nil) (cons y la))) (= (cons (head lb) ((_ update tail) nil (cons 1 nil))) ((_ update tail) (cons 2 la) ((_ update tail) lb lb))) (= (tuple 2 x) (tuple 0 x)))))
(assert (xor a (= (second ((as pair (Pair Int Color)) y red)) blue)))
(assert (= ((_ tuple.update 1) (tuple (+ x 1) 2) ((_ tuple.select 0) (tuple 1 co))) ((_ tuple.update 1) (tuple x 1) ((_ tuple.select 0) tp))))
(check-sat)
