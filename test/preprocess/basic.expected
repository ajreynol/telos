;; post-asserts start
(set-logic ALL)
(declare-sort U 0)
(declare-fun u () U)
(declare-fun v () U)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun a () Bool)
(declare-fun b () Bool)
(declare-fun f (Int) Int)
(assert (= x (+ 1 y)))
(assert (or a (not (>= (+ y (* -1 (f x))) -1))))
(assert a)
(assert (not (>= x 10)))
(assert (not (= u v)))
(assert (not (or a b)))
(assert (xor a (>= z 0)))
(assert true)
(assert true)
(check-sat)
;; post-asserts end
