;; post-asserts start
(set-logic ALL)
(declare-fun t () (Tuple Int Bool Int))
(declare-fun by () (_ BitVec 4))
(declare-fun s () String)
(declare-fun c () Bool)
(declare-fun S () (Set Int))
(define-fun x () Int 0)
(declare-fun @purify_1 () Bool)
(assert (>= ((_ tuple.select 0) t) 4))
(assert (or c (= #b1001 by)))
(assert c)
(assert true)
(assert (let ((_let_1 (str.substr s 0 1))) (let ((_let_2 (= s ""))) (or c _let_2 (not (or _let_2 (= _let_1 "a") (= _let_1 "b")))))))
(assert true)
(assert true)
(assert (= (set.singleton (set.choose S)) (set.union (set.singleton 2) (set.singleton 0))))
(assert (= ((_ tuple.select 1) t) @purify_1))
(check-sat)
;; post-asserts end
