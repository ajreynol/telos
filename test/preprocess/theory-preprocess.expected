;; post-asserts start
(set-logic ALL)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun r () Real)
(declare-fun a () Bool)
(declare-fun b () Bool)
(declare-fun f (Int) Int)
(declare-fun g (Bool) Int)
(declare-fun @purify_1 () Int)
(declare-fun @purify_2 () Bool)
(declare-fun @purify_3 () Int)
(declare-fun @purify_4 () Int)
(declare-fun @purify_5 () Int)
(declare-fun @purify_6 () Int)
(declare-fun @int_div_by_zero_7 (Int) Int)
(declare-fun @purify_8 () Int)
(declare-fun @purify_9 () Int)
(assert (>= (f @purify_1) 4))
(assert (not (>= (+ @purify_1 (* -1 (g @purify_2))) 0)))
(assert (>= @purify_3 4))
(assert (>= (+ x (* -3 @purify_4) (* -1 (f x))) 1))
(assert (>= @purify_5 4))
(assert (>= @purify_6 4))
(assert (= r (to_real @purify_6)))
(assert (>= (@int_div_by_zero_7 x) 4))
(assert true)
(assert (ite a (= x @purify_1) (= @purify_1 @purify_8)))
(assert (ite b (= y @purify_8) (= @purify_8 0)))
(assert (= (and a b) @purify_2))
(assert (ite (= y 0) (= @purify_3 (@int_div_by_zero_7 x)) (= @purify_3 @purify_9)))
(assert (=> (>= y 1) (and (>= (+ x (* -1 (* y @purify_9))) 0) (not (>= (+ x (* -1 y) (* -1 (* y @purify_9))) 0)))))
(assert (=> (not (>= y 0)) (and (>= (+ x (* -1 (* y @purify_9))) 0) (not (>= (+ x y (* -1 (* y @purify_9))) 0)))))
(assert (>= (+ x (* -3 @purify_4)) 0))
(assert (not (>= (+ x (* -3 @purify_4)) 3)))
(assert (ite (>= x 0) (= x @purify_5) (= @purify_5 (* -1 x))))
(assert (>= (+ r (to_real (* -1 @purify_6))) 0/1))
(assert (not (>= (+ r (to_real (* -1 @purify_6))) 1/1)))
(assert (>= (+ r (to_real (* -1 @purify_6))) 0/1))
(assert (not (>= (+ r (to_real (* -1 @purify_6))) 1/1)))
(check-sat)
;; post-asserts end
