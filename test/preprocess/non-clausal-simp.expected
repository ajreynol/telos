;; post-asserts start
(set-logic ALL)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun f (Int) Int)
(declare-fun g (Int) Int)
(define-fun x () Int (+ 1 y))
(define-fun y () Int (+ 2 z))
(define-fun a () Bool true)
(define-fun b () Bool true)
(define-fun c () Bool (not (= w 5)))
(assert true)
(assert true)
(assert (not (>= (+ z (* -1 (f (+ 3 z)))) 0)))
(assert true)
(assert true)
(assert (>= w 1))
(assert true)
(assert (not (>= (f w) 3)))
(assert true)
(assert true)
(assert (= (g w) 3))
(check-sat)
;; post-asserts end
