;; post-asserts start
(set-logic QF_UFLIA)
(declare-sort U 0)
(declare-fun c () Bool)
(declare-fun d () Bool)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun a () U)
(declare-fun b () U)
(declare-fun e () U)
(declare-fun f () U)
(declare-fun @purify_1 () Int)
(declare-fun @purify_2 () Int)
(declare-fun @purify_3 () Int)
(declare-fun @purify_4 () Int)
(declare-fun @purify_5 () Int)
(declare-fun @purify_6 () Int)
(declare-fun @purify_7 () Int)
(assert (>= x 5))
(assert (>= y 0))
(assert (not (>= (+ z (* -1 @purify_1) (* -1 @purify_2)) 0)))
(assert (>= (+ @purify_3 @purify_4) 8))
(assert (>= (+ z (* -1 @purify_5)) 1))
(assert (or (and (= a b) (= b e)) (and (= a f) (= e f))))
(assert (not (>= (+ y (* -1 @purify_6)) 0)))
(assert true)
(assert (>= @purify_2 0))
(assert (not (>= @purify_2 2)))
(assert (=> (>= x 5) (>= @purify_1 4)))
(assert (not (>= (+ z (* -1 @purify_4)) 1)))
(assert (>= @purify_4 3))
(assert (=> (and (>= x 5) (>= y 0)) (>= @purify_3 0)))
(assert (>= (+ y (* -1 @purify_5)) 0))
(assert (not (>= @purify_5 3)))
(assert (=> (>= y 0) (>= @purify_5 0)))
(assert (=> (or (and (= a b) (= b e)) (and (= a f) (= e f))) (= a e)))
(assert (=> (>= x 5) (>= @purify_7 5)))
(assert (=> (>= @purify_7 5) (>= @purify_6 3)))
(assert (ite d (= @purify_2 0) (= @purify_2 1)))
(assert (ite c (= x @purify_1) (= @purify_1 4)))
(assert (ite (>= z 3) (= z @purify_4) (= @purify_4 3)))
(assert (ite c (= x @purify_3) (= y @purify_3)))
(assert (ite (>= y 2) (= @purify_5 2) (= y @purify_5)))
(assert (ite c (= @purify_6 @purify_7) (= @purify_6 3)))
(assert (ite d (= x @purify_7) (= @purify_7 7)))
(check-sat)
;; post-asserts end
