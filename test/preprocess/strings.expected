;; post-asserts start
(set-logic ALL)
(declare-fun x () String)
(declare-fun y () String)
(declare-fun z () String)
(declare-fun n () Int)
(declare-fun @purify_1 () String)
(assert (= y (str.++ x "a")))
(assert (= y z))
(assert true)
(assert (not (str.contains x "a")))
(assert true)
(assert true)
(assert true)
(assert (and (= "" x) (not (= "" y))))
(assert (= (str.len @purify_1) 1))
(assert (ite (and (>= n 0) (not (>= n 196608))) (= n (str.to_code @purify_1)) (= "" @purify_1)))
(check-sat)
;; post-asserts end
