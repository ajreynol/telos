; Sets (cvc5's TheorySetsRewriter): insert and subset elimination, membership,
; union, intersection and difference (with the empty set, of constants, ordered),
; choose, is_empty, is_singleton, and equalities of sets.
(set-logic ALL)
(declare-const x Int)
(declare-const y Int)
(declare-const s (Set Int))
(declare-const t (Set Int))
(simplify (set.insert x s))
(simplify (set.subset s t))
(simplify (set.member x (as set.empty (Set Int))))
(simplify (set.member x (set.singleton y)))
(simplify (set.member x (set.union s t)))
(simplify (set.member x (set.inter s t)))
(simplify (set.member x (set.minus s t)))
(simplify (set.member 1 (set.union (set.singleton 2) (set.singleton 1))))
(simplify (set.member 3 (set.insert 1 2 (set.singleton 4))))
(simplify (set.union s (as set.empty (Set Int))))
(simplify (set.inter (as set.empty (Set Int)) s))
(simplify (set.minus s (as set.empty (Set Int))))
(simplify (set.minus s s))
(simplify (set.union s s))
(simplify (set.inter s s))
(simplify (set.union t s))
(simplify (set.inter t s))
(simplify (set.union (set.singleton 1) (set.singleton 2)))
(simplify (set.union (set.singleton 2) (set.singleton 1)))
(simplify (set.inter (set.union (set.singleton 2) (set.singleton 1)) (set.singleton 1)))
(simplify (set.minus (set.union (set.singleton 2) (set.singleton 1)) (set.singleton 1)))
(simplify (set.minus (set.singleton 1) (set.singleton 1)))
(simplify (set.union (set.singleton 3) (set.union (set.singleton 2) (set.singleton 1))))
(simplify (set.choose (set.singleton x)))
(simplify (set.is_empty s))
(simplify (set.is_empty (set.singleton 1)))
(simplify (set.is_empty (as set.empty (Set Int))))
(simplify (set.is_singleton (as set.empty (Set Int))))
(simplify (set.is_singleton (set.singleton x)))
(simplify (set.is_singleton s))
(simplify (= s s))
(simplify (= t s))
(simplify (= (set.singleton 1) (set.singleton 2)))
(simplify (= (set.singleton 1) (as set.empty (Set Int))))
(simplify (= s (set.insert x t)))
(simplify (set.insert 1 2 3 (as set.empty (Set Int))))
(simplify (set.union (as set.empty (Set Int)) (as set.empty (Set Int))))
(simplify (set.inter (set.singleton 1) (set.singleton 1)))
(simplify (set.union (set.union (set.singleton 2) (set.singleton 1)) (set.union (set.singleton 2) (set.singleton 1))))
