(simplify (seq.indexof x y 0))
(simplify (seq.replace_all x (as seq.empty (Seq Int)) y))
(simplify (seq.replace (as seq.empty (Seq Int)) x y))
(simplify (seq.len (seq.update x i y)))
(simplify (= x (seq.++ x y)))
(simplify (seq.nth x i))
(simplify (seq.contains (seq.++ (seq.unit 1) x) (seq.unit 1)))
