(set-logic ALL)
(declare-const x (Seq Int))
(declare-const y (Seq Int))
(declare-const i Int)
(declare-const j Int)
(simplify (seq.++ x (as seq.empty (Seq Int)) y))
(simplify (seq.len (seq.unit i)))
(simplify (seq.len (seq.++ x (seq.unit i) y)))
(simplify (seq.len (as seq.empty (Seq Int))))
(simplify (seq.nth (seq.unit i) 0))
(simplify (seq.nth (seq.++ (seq.unit 0) (seq.unit 1)) 1))
(simplify (seq.nth (seq.++ x (seq.unit j) y) (seq.len x)))
(simplify (= (seq.unit i) (seq.unit j)))
(simplify (= (seq.unit 1) (seq.unit 2)))
(simplify (= (seq.++ (seq.unit 1) x) (seq.++ (seq.unit 2) y)))
(simplify (= x (as seq.empty (Seq Int))))
(simplify (= (seq.++ x y) (as seq.empty (Seq Int))))
(simplify (seq.extract x 0 (seq.len x)))
(simplify (seq.extract (seq.++ (seq.unit 1) (seq.unit 2) x) 1 1))
(simplify (seq.extract x 0 0))
(simplify (seq.extract (as seq.empty (Seq Int)) i j))
(simplify (seq.at x 0))
(simplify (seq.contains (seq.++ x y) x))
(simplify (seq.contains x (as seq.empty (Seq Int))))
(simplify (seq.contains (seq.unit i) (seq.++ (seq.unit i) (seq.unit j))))
(simplify (seq.contains (seq.unit 1) (seq.unit 2)))
(simplify (seq.prefixof x y))
(simplify (seq.prefixof x (as seq.empty (Seq Int))))
(simplify (seq.suffixof (seq.unit i) x))
(simplify (seq.update x 0 (seq.unit i)))
(simplify (seq.update (seq.unit j) 0 (seq.unit i)))
(simplify (seq.rev (seq.++ x (seq.unit i))))
(simplify (seq.rev (seq.unit i)))
(simplify (seq.replace x (as seq.empty (Seq Int)) y))
