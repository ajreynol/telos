(prereg 0 true)
(prereg 0 false)
(prereg 1 (P @purify_2 @purify_1))
(ee-new-class 1 @purify_1)
(ee-new-class 1 @purify_2)
(ee-new-class 1 P)
(ee-new-class 1 (P @purify_2 @purify_1))
(prereg 1 @purify_1)
(prereg 1 (P @purify_4 @purify_3))
(ee-new-class 1 @purify_3)
(ee-new-class 1 @purify_4)
(ee-new-class 1 (P @purify_4 @purify_3))
(prereg 1 @purify_2)
(prereg 1 (P @purify_3 @purify_5))
(ee-new-class 1 @purify_5)
(ee-new-class 1 (P @purify_3 @purify_5))
(prereg 1 @purify_3)
(prereg 1 @purify_4)
(prereg 1 @purify_5)
(prereg 1 (P @purify_4 @purify_4))
(ee-new-class 1 (P @purify_4 @purify_4))
(assert 1 THEORY_UF (P @purify_2 @purify_1))
(assert 1 THEORY_UF @purify_3)
(assert 1 THEORY_UF (not @purify_4))
(check 1 THEORY_UF EFFORT_STANDARD)
(ee-merge 1 true (P @purify_2 @purify_1))
(propagate 1 THEORY_BUILTIN (P @purify_2 @purify_1))
(ee-merge 1 true @purify_3)
(ee-merge 1 false @purify_4)
(assert 2 THEORY_UF (P @purify_4 @purify_4))
(assert 2 THEORY_UF @purify_5)
(check 2 THEORY_UF EFFORT_STANDARD)
(ee-merge 2 true (P @purify_4 @purify_4))
(propagate 2 THEORY_BUILTIN (P @purify_4 @purify_4))
(ee-merge 2 true @purify_5)
(assert 3 THEORY_UF (P @purify_3 @purify_5))
(assert 3 THEORY_UF @purify_2)
(check 3 THEORY_UF EFFORT_STANDARD)
(ee-merge 3 true (P @purify_3 @purify_5))
(propagate 3 THEORY_BUILTIN (P @purify_3 @purify_5))
(ee-merge 3 true @purify_2)
(assert 4 THEORY_UF (P @purify_4 @purify_3))
(assert 4 THEORY_UF @purify_1)
(check 4 THEORY_UF EFFORT_STANDARD)
(ee-merge 4 true (P @purify_4 @purify_3))
(propagate 4 THEORY_BUILTIN (P @purify_4 @purify_3))
(ee-merge 4 true @purify_1)
(check 4 THEORY_UF EFFORT_FULL)
