(prereg 0 true)
(prereg 0 false)
(prereg 1 (= b (f c)))
(ee-new-class 1 c)
(ee-new-class 1 f)
(ee-new-class 1 (f c))
(ee-new-class 1 b)
(prereg 1 (= c (f c)))
(prereg 1 (= b (f b)))
(ee-new-class 1 (f b))
(prereg 1 (= b c))
(prereg 1 (= (f b) (f c)))
(assert 1 THEORY_UF (not (= (f b) (f c))))
(assert 1 THEORY_UF (not (= b c)))
(assert 1 THEORY_UF (not (= b (f b))))
(check 1 THEORY_UF EFFORT_STANDARD)
(ee-diseq 1 (f b) (f c) (not (= (f b) (f c))))
(ee-merge 1 false (= (f b) (f c)))
(propagate 1 THEORY_BUILTIN (not (= (f b) (f c))))
(ee-diseq 1 b c (not (= b c)))
(ee-merge 1 false (= b c))
(propagate 1 THEORY_BUILTIN (not (= b c)))
(ee-diseq 1 b (f b) (not (= b (f b))))
(ee-merge 1 false (= b (f b)))
(propagate 1 THEORY_BUILTIN (not (= b (f b))))
(assert 2 THEORY_UF (= c (f c)))
(check 2 THEORY_UF EFFORT_STANDARD)
(ee-merge 2 c (f c))
(propagate 2 THEORY_BUILTIN (= c (f c)))
(ee-merge 2 true (= c (f c)))
(ee-merge 2 false (= b (f c)))
(propagate 2 THEORY_BUILTIN (not (= b (f c))))
(assert 2 THEORY_UF (not (= b (f c))))
(check 2 THEORY_UF EFFORT_STANDARD)
(check 2 THEORY_UF EFFORT_FULL)
