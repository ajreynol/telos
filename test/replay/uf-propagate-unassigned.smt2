(set-logic QF_UF)
(declare-sort U 0)
(declare-fun c () U)
(define-fun a () U c)
(declare-fun f (U) U)
(declare-fun b () U)
(assert (let ((_let_1 (f c))) (or (= b _let_1) (= c _let_1))))
(assert (or (not (= b (f b))) (= b c)))
