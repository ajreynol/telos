(set-logic QF_UF)
(declare-sort U 0)
(declare-fun u () U)
(declare-fun v () U)
(declare-fun w () U)
(declare-fun f (U) U)
(declare-fun g (U U) U)
(declare-fun P (U) Bool)
(declare-fun h (U U U) U)
(assert (let ((_let_1 (f u))) (let ((_let_2 (f v))) (or (not (= (f (g w w)) (h (f w) _let_2 (g v v)))) (not (P _let_1)) (= _let_2 _let_1)))))
(assert (let ((_let_1 (P w))) (or (not _let_1) _let_1 (not (= u (f (f (f u))))))))
(assert (not (= (f v) (g (f w) u))))
(assert (let ((_let_1 (f w))) (let ((_let_2 (f v))) (let ((_let_3 (f u))) (or (= _let_1 _let_3) (not (P (f _let_3))) (not (= _let_2 (g _let_2 _let_1))))))))
(assert (not (= (f u) (f (g w u)))))
(assert (let ((_let_1 (f w))) (or (not (= _let_1 (f (g v v)))) (not (= w _let_1)) (not (= v (f (f v)))))))
(assert (not (= w (h v (h v v w) w))))
(assert (let ((_let_1 (f v))) (not (= _let_1 (f _let_1)))))
(assert (let ((_let_1 (f w))) (or (not (= (g _let_1 w) (f _let_1))) (P (f (f v))))))
(assert (or (not (= (f u) (g u (g v v)))) (= v (f (f v)))))
(assert true)
(check-sat)
