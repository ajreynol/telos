/-!
# Node kinds

A copy of cvc5's internal `Kind` enumeration (`src/expr/kind_template.h`,
generated from the theories' `kinds` files). The constructor names are cvc5's, so
code ported from cvc5's rewriters reads the same.

Only kinds that `Node.toEo` (`Telos/Node/ToEo.lean`) gives a semantics to are
listed. When you add a kind, add its `toEo` case in the same change. A kind with no
`toEo` case translates to `Term.Stuck`, so no node of that kind is well typed.
-/

namespace Telos

inductive Kind where
  -- Constants (cvc5 `CONST_*` kinds; the payload is in `Const`).
  | CONST_BOOLEAN
  | CONST_INTEGER
  | CONST_RATIONAL
  | CONST_BITVECTOR
  | CONST_STRING
  /-- The empty set (cvc5's `SET_EMPTY`, a constant whose payload is its type). -/
  | SET_EMPTY
  -- Variables (cvc5 `VARIABLE`, for user-declared constants and functions, and
  -- `BOUND_VARIABLE`).
  | VARIABLE
  | BOUND_VARIABLE
  -- theory/builtin
  | EQUAL
  -- theory/booleans
  | NOT
  | AND
  | IMPLIES
  | OR
  | XOR
  | ITE
  -- theory/arith
  | ADD
  | SUB
  | NEG
  | MULT
  | DIVISION
  | INTS_DIVISION
  | INTS_MODULUS
  | DIVISION_TOTAL
  | INTS_DIVISION_TOTAL
  | INTS_MODULUS_TOTAL
  | ABS
  | LT
  | LEQ
  | GT
  | GEQ
  | TO_REAL
  | TO_INTEGER
  | IS_INTEGER
  | POW2
  | INTS_LOG2
  | INTS_ISPOW2
  -- theory/bv (parameterized kinds take their indices from `Op.indexed`)
  | BITVECTOR_EXTRACT
  | BITVECTOR_CONCAT
  | BITVECTOR_AND
  | BITVECTOR_OR
  | BITVECTOR_XOR
  | BITVECTOR_ADD
  | BITVECTOR_MULT
  | BITVECTOR_NOT
  | BITVECTOR_NEG
  | BITVECTOR_REDOR
  | BITVECTOR_REDAND
  | BITVECTOR_NEGO
  | BITVECTOR_SIZE
  | BITVECTOR_NAND
  | BITVECTOR_NOR
  | BITVECTOR_XNOR
  | BITVECTOR_COMP
  | BITVECTOR_SUB
  | BITVECTOR_UDIV
  | BITVECTOR_UREM
  | BITVECTOR_SDIV
  | BITVECTOR_SREM
  | BITVECTOR_SMOD
  | BITVECTOR_SHL
  | BITVECTOR_LSHR
  | BITVECTOR_ASHR
  | BITVECTOR_ULT
  | BITVECTOR_ULE
  | BITVECTOR_UGT
  | BITVECTOR_UGE
  | BITVECTOR_SLT
  | BITVECTOR_SLE
  | BITVECTOR_SGT
  | BITVECTOR_SGE
  | BITVECTOR_ULTBV
  | BITVECTOR_SLTBV
  | BITVECTOR_UADDO
  | BITVECTOR_SADDO
  | BITVECTOR_UMULO
  | BITVECTOR_SMULO
  | BITVECTOR_USUBO
  | BITVECTOR_SSUBO
  | BITVECTOR_SDIVO
  | BITVECTOR_ITE
  | BITVECTOR_REPEAT
  | BITVECTOR_ZERO_EXTEND
  | BITVECTOR_SIGN_EXTEND
  | BITVECTOR_ROTATE_LEFT
  | BITVECTOR_ROTATE_RIGHT
  -- theory/uf (the function is the operator: `Op.node APPLY_UF f`)
  | APPLY_UF
  | DISTINCT
  | INT_TO_BITVECTOR
  | BITVECTOR_UBV_TO_INT
  | BITVECTOR_SBV_TO_INT
  -- theory/strings
  | STRING_CONCAT
  | REGEXP_CONCAT
  | REGEXP_INTER
  | REGEXP_UNION
  | STRING_LENGTH
  | STRING_SUBSTR
  | STRING_UPDATE
  | STRING_CHARAT
  | STRING_CONTAINS
  | STRING_LT
  | STRING_LEQ
  | STRING_INDEXOF
  | STRING_INDEXOF_RE
  | STRING_REPLACE
  | STRING_REPLACE_ALL
  | STRING_REPLACE_RE
  | STRING_REPLACE_RE_ALL
  | STRING_PREFIX
  | STRING_SUFFIX
  | STRING_IS_DIGIT
  | STRING_ITOS
  | STRING_STOI
  | STRING_TO_CODE
  | STRING_FROM_CODE
  | STRING_TO_LOWER
  | STRING_TO_UPPER
  | STRING_REV
  | STRING_TO_REGEXP
  | STRING_IN_REGEXP
  | REGEXP_NONE
  | REGEXP_ALL
  | REGEXP_ALLCHAR
  | REGEXP_DIFF
  | REGEXP_STAR
  | REGEXP_PLUS
  | REGEXP_OPT
  | REGEXP_RANGE
  | REGEXP_COMPLEMENT
  | REGEXP_REPEAT
  | REGEXP_LOOP
  -- theory/arrays
  | SELECT
  | STORE
  -- theory/sets (the operators of cvc5's safe mode with a CPC counterpart)
  | SET_SINGLETON
  | SET_UNION
  | SET_INTER
  | SET_MINUS
  | SET_MEMBER
  | SET_SUBSET
  | SET_CHOOSE
  | SET_IS_EMPTY
  | SET_IS_SINGLETON
  | SET_INSERT
  -- theory/quantifiers
  | FORALL
  | EXISTS
  | BOUND_VAR_LIST
  /-- Instantiation patterns. They carry no semantics, and `toEo` drops them. -/
  | INST_PATTERN_LIST
  deriving DecidableEq, Repr, Inhabited, Hashable, Ord

/-- cvc5's `TheoryId` (`src/theory/theory_id.h`), for the theories `Kind` covers. -/
inductive TheoryId where
  | THEORY_BUILTIN
  | THEORY_BOOL
  | THEORY_ARITH
  | THEORY_BV
  | THEORY_UF
  | THEORY_ARRAYS
  | THEORY_SETS
  | THEORY_STRINGS
  | THEORY_QUANTIFIERS
  deriving DecidableEq, Repr, Inhabited

/-- cvc5's `kindToTheoryId`: the theory that owns a kind, and whose rewriter
rewrites nodes of that kind. -/
def Kind.theoryId : Kind → TheoryId
  | .CONST_BOOLEAN => .THEORY_BOOL
  | .CONST_INTEGER | .CONST_RATIONAL => .THEORY_ARITH
  | .CONST_BITVECTOR => .THEORY_BV
  | .CONST_STRING => .THEORY_STRINGS
  | .SET_EMPTY => .THEORY_SETS
  | .VARIABLE | .BOUND_VARIABLE | .EQUAL => .THEORY_BUILTIN
  | .NOT | .AND | .IMPLIES | .OR | .XOR | .ITE => .THEORY_BOOL
  | .ADD | .SUB | .NEG | .MULT | .DIVISION | .INTS_DIVISION | .INTS_MODULUS | .ABS
  | .DIVISION_TOTAL | .INTS_DIVISION_TOTAL | .INTS_MODULUS_TOTAL
  | .LT | .LEQ | .GT | .GEQ | .TO_REAL | .TO_INTEGER | .IS_INTEGER
  | .POW2 | .INTS_LOG2 | .INTS_ISPOW2 => .THEORY_ARITH
  | .BITVECTOR_EXTRACT => .THEORY_BV
  | .BITVECTOR_CONCAT => .THEORY_BV
  | .BITVECTOR_AND => .THEORY_BV
  | .BITVECTOR_OR => .THEORY_BV
  | .BITVECTOR_XOR => .THEORY_BV
  | .BITVECTOR_ADD => .THEORY_BV
  | .BITVECTOR_MULT => .THEORY_BV
  | .BITVECTOR_NOT => .THEORY_BV
  | .BITVECTOR_NEG => .THEORY_BV
  | .BITVECTOR_REDOR => .THEORY_BV
  | .BITVECTOR_REDAND => .THEORY_BV
  | .BITVECTOR_NEGO => .THEORY_BV
  | .BITVECTOR_SIZE => .THEORY_BV
  | .BITVECTOR_NAND => .THEORY_BV
  | .BITVECTOR_NOR => .THEORY_BV
  | .BITVECTOR_XNOR => .THEORY_BV
  | .BITVECTOR_COMP => .THEORY_BV
  | .BITVECTOR_SUB => .THEORY_BV
  | .BITVECTOR_UDIV => .THEORY_BV
  | .BITVECTOR_UREM => .THEORY_BV
  | .BITVECTOR_SDIV => .THEORY_BV
  | .BITVECTOR_SREM => .THEORY_BV
  | .BITVECTOR_SMOD => .THEORY_BV
  | .BITVECTOR_SHL => .THEORY_BV
  | .BITVECTOR_LSHR => .THEORY_BV
  | .BITVECTOR_ASHR => .THEORY_BV
  | .BITVECTOR_ULT => .THEORY_BV
  | .BITVECTOR_ULE => .THEORY_BV
  | .BITVECTOR_UGT => .THEORY_BV
  | .BITVECTOR_UGE => .THEORY_BV
  | .BITVECTOR_SLT => .THEORY_BV
  | .BITVECTOR_SLE => .THEORY_BV
  | .BITVECTOR_SGT => .THEORY_BV
  | .BITVECTOR_SGE => .THEORY_BV
  | .BITVECTOR_ULTBV => .THEORY_BV
  | .BITVECTOR_SLTBV => .THEORY_BV
  | .BITVECTOR_UADDO => .THEORY_BV
  | .BITVECTOR_SADDO => .THEORY_BV
  | .BITVECTOR_UMULO => .THEORY_BV
  | .BITVECTOR_SMULO => .THEORY_BV
  | .BITVECTOR_USUBO => .THEORY_BV
  | .BITVECTOR_SSUBO => .THEORY_BV
  | .BITVECTOR_SDIVO => .THEORY_BV
  | .BITVECTOR_ITE => .THEORY_BV
  | .BITVECTOR_REPEAT => .THEORY_BV
  | .BITVECTOR_ZERO_EXTEND => .THEORY_BV
  | .BITVECTOR_SIGN_EXTEND => .THEORY_BV
  | .BITVECTOR_ROTATE_LEFT => .THEORY_BV
  | .BITVECTOR_ROTATE_RIGHT => .THEORY_BV
  | .APPLY_UF | .DISTINCT | .INT_TO_BITVECTOR | .BITVECTOR_UBV_TO_INT | .BITVECTOR_SBV_TO_INT =>
    .THEORY_UF
  | .SELECT | .STORE => .THEORY_ARRAYS
  | .SET_SINGLETON | .SET_UNION | .SET_INTER | .SET_MINUS | .SET_MEMBER | .SET_SUBSET
  | .SET_CHOOSE | .SET_IS_EMPTY | .SET_IS_SINGLETON | .SET_INSERT => .THEORY_SETS
  | .STRING_CONCAT => .THEORY_STRINGS
  | .REGEXP_CONCAT => .THEORY_STRINGS
  | .REGEXP_INTER => .THEORY_STRINGS
  | .REGEXP_UNION => .THEORY_STRINGS
  | .STRING_LENGTH => .THEORY_STRINGS
  | .STRING_SUBSTR => .THEORY_STRINGS
  | .STRING_UPDATE => .THEORY_STRINGS
  | .STRING_CHARAT => .THEORY_STRINGS
  | .STRING_CONTAINS => .THEORY_STRINGS
  | .STRING_LT => .THEORY_STRINGS
  | .STRING_LEQ => .THEORY_STRINGS
  | .STRING_INDEXOF => .THEORY_STRINGS
  | .STRING_INDEXOF_RE => .THEORY_STRINGS
  | .STRING_REPLACE => .THEORY_STRINGS
  | .STRING_REPLACE_ALL => .THEORY_STRINGS
  | .STRING_REPLACE_RE => .THEORY_STRINGS
  | .STRING_REPLACE_RE_ALL => .THEORY_STRINGS
  | .STRING_PREFIX => .THEORY_STRINGS
  | .STRING_SUFFIX => .THEORY_STRINGS
  | .STRING_IS_DIGIT => .THEORY_STRINGS
  | .STRING_ITOS => .THEORY_STRINGS
  | .STRING_STOI => .THEORY_STRINGS
  | .STRING_TO_CODE => .THEORY_STRINGS
  | .STRING_FROM_CODE => .THEORY_STRINGS
  | .STRING_TO_LOWER => .THEORY_STRINGS
  | .STRING_TO_UPPER => .THEORY_STRINGS
  | .STRING_REV => .THEORY_STRINGS
  | .STRING_TO_REGEXP => .THEORY_STRINGS
  | .STRING_IN_REGEXP => .THEORY_STRINGS
  | .REGEXP_NONE => .THEORY_STRINGS
  | .REGEXP_ALL => .THEORY_STRINGS
  | .REGEXP_ALLCHAR => .THEORY_STRINGS
  | .REGEXP_DIFF => .THEORY_STRINGS
  | .REGEXP_STAR => .THEORY_STRINGS
  | .REGEXP_PLUS => .THEORY_STRINGS
  | .REGEXP_OPT => .THEORY_STRINGS
  | .REGEXP_RANGE => .THEORY_STRINGS
  | .REGEXP_COMPLEMENT => .THEORY_STRINGS
  | .REGEXP_REPEAT => .THEORY_STRINGS
  | .REGEXP_LOOP => .THEORY_STRINGS
  | .FORALL | .EXISTS | .BOUND_VAR_LIST | .INST_PATTERN_LIST => .THEORY_QUANTIFIERS

/-- The quantifier kinds, whose congruence is in their body only. -/
def Kind.isQuantifier : Kind → Bool
  | .FORALL | .EXISTS => true
  | _ => false

end Telos
